{
  "name": "@lannguyensi/memory-router",
  "version": "0.9.1",
  "description": "Deterministic memory injection for Claude Code: topic, tool, and confidence gates against your ~/.claude/projects/*/memory/*.md files, plus lint and stale-reference tooling.",
  "license": "MIT",
  "homepage": "https://github.com/LanNguyenSi/agent-memory/tree/master/packages/memory-router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LanNguyenSi/agent-memory.git",
    "directory": "packages/memory-router"
  },
  "bugs": {
    "url": "https://github.com/LanNguyenSi/agent-memory/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "memory",
    "agent",
    "hook",
    "mcp",
    "sqlite-vec"
  ],
  "main": "./dist/index.js",
  "bin": {
    "memory-router": "./dist/cli.js",
    "memory-router-user-prompt-submit": "./dist/hooks/user-prompt-submit.js",
    "memory-router-pre-tool-use": "./dist/hooks/pre-tool-use.js",
    "memory-router-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bins.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "node --import tsx --test 'tests/**/*.test.ts'",
    "pretest:coverage": "npm run build",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='dist/**' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80 'tests/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ip-address": "^10.7.2"
  }
}
